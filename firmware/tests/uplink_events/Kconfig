# uplink.c 需要的项目 Kconfig 符号。
#
# 真固件的定义在 firmware/nrf52840/Kconfig；这里只补齐让 uplink.c + proto.c
# 能编。值随便填 —— 但 CONFIG_EBIKE_ALLOW_REMOTE_UNLOCK 的默认必须和真固件
# 一致（n），否则 handle_cmd 的分支就不是被测的那条。

config EBIKE_DEVICE_ID
	string "设备 id"
	default "bike01"

config EBIKE_FW_VERSION
	string "固件版本"
	default "0.0.0-test"

config EBIKE_ALLOW_REMOTE_UNLOCK
	bool "允许远程开锁（契约 §6.1，默认关）"
	default n

config EBIKE_LOG_LEVEL
	int "本项目模块的日志等级"
	default 4
	range 0 4

source "Kconfig.zephyr"
