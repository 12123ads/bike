# motion.c 需要的项目 Kconfig 符号。
#
# 真固件的定义在 firmware/nrf52840/Kconfig；这里只补齐让 motion.c 能编，
# 但 **STILL_AFTER_S 刻意设成 2 秒**（真固件默认 30）——
# 否则每个用例都要等半分钟。测试断言用的是这个符号本身，不是硬编码的秒数，
# 所以改这个值不会让测试失真。

config EBIKE_STILL_AFTER_S
	int "多久没有运动事件就判静止（秒）"
	default 2
	range 1 600

config EBIKE_MOTION_THRESHOLD_MG
	int "运动唤醒阈值（mg）"
	default 150
	range 31 2000

config EBIKE_LOG_LEVEL
	int "本项目模块的日志等级"
	default 4
	range 0 4

source "Kconfig.zephyr"
