/*
 * native_sim 上顶掉 battery.c 的硬件依赖。
 *
 * battery.c 要三样东西：`DT_NODELABEL(vbatt)`（voltage-divider 节点）、
 * 它的 `io-channels` 指向的 ADC 通道、以及 `DT_NODELABEL(batt_gate)` 的
 * 门控脚。ADC 换成 native_sim 自带的 adc-emul（`adc0`），门控脚接 gpio-emul。
 *
 * ⚠ **分压比、gain、reference、resolution 必须与真 overlay 逐字一致**
 *   （4.7M+4.7M / 470k = 21:1、ADC_GAIN_1_6、ADC_REF_INTERNAL、12 bit）：
 *   battery.c 的 BUILD_ASSERT 用 `full-ohms`/`output-ohms` 做输入，而测试的
 *   毫伏边界断言依赖整条换算链 `(raw * 600 * 6 >> 12) * 21`。改任何一个，
 *   测的就不是真固件那份换算。
 *
 * ⚠ `ref-internal-mv = <600>` 必须显式给：adc-emul 的默认值是 0，而
 *   `adc_emul_channel_setup()` 在 ADC_REF_INTERNAL 的参考电压为 0 时返回
 *   -ENOTSUP → `battery_init()` 直接失败。600 mV 就是 nRF52840 SAADC 的
 *   内部参考（真 overlay 的注释里算过：gain 1/6 × 600 mV → 满量程 3600 mV）。
 *
 * ⚠ 采集时间用 ADC_ACQ_TIME_DEFAULT，不抄真 overlay 的 40 µs：adc-emul 不看
 *   这个值，而写具体数字会让人以为它在测源阻抗那条约束。
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	ebike_outputs {
		compatible = "gpio-leds";

		/* 分压门控 MOSFET。真 overlay 里是 P0.10（J3.2），这里随便挑一个
		 * gpio-emul 的脚 —— 测试断言的是「采完必须回到 0」，不是脚号。 */
		batt_gate: batt_gate {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			label = "battery divider gate";
		};
	};

	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc0 0>;
		output-ohms = <470000>;
		full-ohms = <(4700000 + 4700000 + 470000)>;
		power-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
	};
};

&adc0 {
	#address-cells = <1>;
	#size-cells = <0>;
	ref-internal-mv = <600>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
