menu "电瓶车定位固件"

config EBIKE_DEVICE_ID
	string "设备 id（等于 MQTT 用户名，出现在 topic 层级里）"
	default "bike01"
	help
	  必须匹配 [a-z0-9-]{1,32}，且服务端配置里要有同名设备。
	  契约 §4：id 在 topic 层级里，ACL 靠前缀隔离。

config EBIKE_FW_VERSION
	string "固件版本（上报在 up/hello 的 fw 字段）"
	default "0.1.0"

config EBIKE_MQTT_HOST
	string "MQTT 服务端主机名或 IP"
	default "192.168.1.10"
	help
	  必须与服务端证书的 CN 一致 —— 模组的 AT+SSLCFG="hostname" 会校验它。
	  填错的话设备侧只会看到一个 ERROR，隔着 9600 baud 极难诊断。

config EBIKE_MQTT_PORT
	int "MQTT 端口"
	default 8883

config EBIKE_MQTT_PASSWORD
	string "MQTT 口令"
	default ""
	help
	  由服务端的 `ebike-server init` 生成，只显示一次。
	  ⚠ 这个值会明文进固件二进制。设备装在车上，拆开就能读 flash
	  （DESIGN.md §5.4 第 1 条已承认这个攻击面），所以它和客户端证书
	  私钥的安全等级一样 —— 这正是契约 §2 决定不做 mTLS 的理由。

config EBIKE_REPORT_INTERVAL
	int "默认上报周期（秒）"
	default 900
	help
	  服务端的离线判定 = 本值 × 3 + 120（契约 §4.2），
	  改这里要同时改服务端配置的 report_interval。

config EBIKE_MOTION_THRESHOLD_MG
	int "运动唤醒阈值（mg）"
	default 150
	range 31 2000
	help
	  LIS2DW12 的 WAKE_UP_THS 一格 = 31.25 mg（±2 g 量程）。
	  电瓶车从 100~200 mg 起调（DESIGN.md §3.7）。
	  阈值只能运行时设，不是 DTS 属性。

config EBIKE_STILL_AFTER_S
	int "多久没有运动事件就判静止（秒）"
	default 30
	range 5 600
	help
	  软件静止判定的超时。**硬件的 STATIONARY 事件在本板上用不了**
	  （走 INT2，只接了 INT1），所以静止完全靠这个计时器 ——
	  详见 src/motion.h 的长注释。

	  必须明显小于 main.c 的 IDLE_AFTER_STILL_MS（5 分钟，关广播的门槛）：
	  前者判「不动了」，后者判「不动够久了」。设得比它大的话关广播的条件
	  永远等不到。motion.c 里有 BUILD_ASSERT 钉这一条。

	  30 秒的取值：等红灯、推车挪位这类停顿不该立刻判成静止，
	  但也不能久到让「车被搬走后又静止了」这个事件迟迟不上报。

config EBIKE_LOW_VOLT_1
	int "第一欠压阈值（毫伏）"
	default 46000
	help
	  跨过就降低上报频率并报 lowbatt lv=1（DESIGN.md §6）。
	  具体值依赖实际电池组的 BMS 截止点，采购后实测确定。

config EBIKE_LOW_VOLT_2
	int "第二欠压阈值（毫伏）"
	default 44000
	help
	  跨过就停止周期上报，只保留手机 BLE 开锁（那条路完全离线，不吃车电池
	  的通信开销）。运动事件仍然会触发一次上报 —— 车在这个电量下被动了，
	  比省那点电重要。

config EBIKE_LOW_VOLT_3
	int "第三欠压阈值（毫伏）"
	default 42000
	help
	  跨过就主动进 System OFF，只留运动唤醒（DESIGN.md §6 第 4 级）。
	  这一级是保护**车电池**不被抽空，不是保护设备自己（设备没有独立电源）。
	  42 V 是 48 V 铅酸 12 节 × 1.75 V/节 的物理底线；锂电要按 BMS 截止点改。
	  必须 < LOW_VOLT_2，否则第 2 级永远不会生效。

config EBIKE_ALLOW_REMOTE_UNLOCK
	bool "接受下行的 unlock 指令"
	default n
	help
	  远程开锁绕过 §5.2 的挑战应答，信的只是 MQTT 那层的 TLS + 口令。
	  服务端侧默认也是关的（契约 §6.1），两边都要打开才生效。

config EBIKE_LOG_LEVEL
	int "本项目模块的日志等级"
	default 3
	range 0 4

endmenu

source "Kconfig.zephyr"
