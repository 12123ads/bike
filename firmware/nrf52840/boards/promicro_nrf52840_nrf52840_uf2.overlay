/*
 * 板级 overlay：nRF52840 ProMicro 克隆板。
 *
 * ⚠ 三件必须对着实物/netlist 核的事（DESIGN.md §3.4 / §3.5）：
 *
 * 1. **只能用引出到排针的脚。** SoC 有 48 个 GPIO，这块板子只把 **21 个**
 *    引到焊盘，其余的**只到芯片焊盘、哪儿都不通** —— 而 devicetree 对此
 *    一无所知，填一个没引出的脚**编译照过**，直到接线时才发现没地方接。
 *    这个坑已经踩过三次（P0.04 门控、P0.12 PWRKEY、P0.26 RI，都在
 *    2026-09-04 从 `sasodoma/nrf52840-promicro` 的 netlist 逐脚复核时抓到）。
 *
 *    **引出脚白名单**（逐个 pad 追 net → 元件焊盘数出来的）：
 *      J2 十个：P0.06 P0.08 P0.17 P0.20 P0.22 P0.24 P1.00 P0.11 P1.04 P1.06
 *      J3 八个：P0.09 P0.10 P1.11 P1.13 P1.15 P0.02 P0.29 P0.31
 *      J4 三个：P1.01 P1.02 P1.07
 *    板内占用不引出：P0.00/P0.01（Y2 晶振）、P0.13（ME6217 CE）、P0.15（蓝 LED）。
 *    J3 第 10 个焊盘是 RESET（UICR.PSELRESET = P0.18），不能当 GPIO 用。
 *    `server/tests/test_firmware_contract.py` 把这份白名单钉成断言。
 *
 * 2. **pinctrl 冲突**：上游 promicro_nrf52840-pinctrl.dtsi 的 uart0 是
 *    TX=P0.09 / RX=P0.10。下面把 uart0 挪到 P0.06/P0.08，并新开 uart1
 *    给 Air780EP。
 *    （挪开的原始理由是 P0.09/P0.10 要给 NFCT；开锁改走 BLE 之后那两个脚
 *    自由了，其中 P0.10 现在给了 `batt_gate`，P0.09 是余量。）
 *
 * 3. **上游板级 DTS 会悄悄抢走排针脚**，文件末尾统一关掉：
 *    `i2c1`（P1.04/P1.06 = J2.12/J2.13）、`spi2`（P1.01/P1.02/P1.07 = 整个 J4）。
 *    i2c1 尤其阴险：`CONFIG_I2C_NRFX_TWIM=y` 让 twim1 真的实例化，
 *    `pm_device_driver_init()` 的 RESUME 会 `pinctrl_apply_state(DEFAULT)`，
 *    **开机就把那两个脚配成 I2C**（ELF 里 `__device_dts_ord_73` 实测存在）。
 *
 * 用掉 13 个（下面逐个数），余 8 个：P0.02 P0.09 P0.29 P1.01 P1.02 P1.04
 * P1.06 P1.07。锁要 3 根线、INT2 那根第二中断线都装得下。
 */

/* `power-mode` / `wakeup-duration` 用的是 LIS2DW12 的 dt-bindings 宏，
 * 而板级 DTS 不会带进这个头 —— 不显式 include 就是一个
 * 「expected number or parenthesized expression」的 devicetree parse error。
 * 其余宏（GPIO_ACTIVE_*、NRF_PSEL、NRF_SAADC_*、I2C_BITRATE_*）由
 * 板级 DTS / SoC dtsi 一路带进来，不用再 include。 */
#include <zephyr/dt-bindings/sensor/lis2dw12.h>

/ {
	aliases {
		/* ⚠ **只保留真正被 DT_ALIAS 取用的那一个。**
		 * 其余五个（lock-drive / lock-sense / batt-gate / gnss-power /
		 * modem-pwrkey）删掉了：所有 .c 文件一律用
		 * `DT_NODELABEL(...)`，那些别名是纯装饰，留着只会让人以为
		 * 换引脚时改别名就够了。
		 *
		 * `motion-int` 留着是因为 main.c 的 `enter_system_off()` 用
		 * `DT_ALIAS(motion_int)` 拿这根线 —— 它要绕过 LIS2DW12 驱动
		 * 自己把触发方式从边沿改成 level sense（GPIOTE 在 System OFF
		 * 下断电，只有 SENSE→DETECT 能唤醒）。 */
		motion-int = &motion_int;
	};

	ebike_gpios {
		compatible = "gpio-keys";

		/* LIS2DW12 INT1。
		 * ⚠ **这个节点和 `&lis2dw12` 的 `irq-gpios` 是同一根物理线**
		 * （都是 P1.11）。两处声明是故意的、也是必需的：
		 * 传感器驱动按边沿触发配它（`GPIO_INT_EDGE_TO_ACTIVE`），
		 * 而进 System OFF 前应用层必须把它重配成 level sense
		 * （见 main.c 的 `enter_system_off()`）—— 那需要一个
		 * 独立于传感器驱动的 `gpio_dt_spec`，就是这个节点。
		 *
		 * `gpio-keys` 只是借用一个通用的 GPIO 容器 binding；
		 * `CONFIG_GPIO_KEYS` 没开，所以上游 gpio_keys 驱动不会实例化它。
		 *
		 * 传感器侧必须配成推挽高有效 —— 开漏+上拉会让引脚停在
		 * VIL/VIH 之间，nRF52840 手册明确说那会增加电流（DESIGN.md §3.7），
		 * 而且悬空电平会让 level sense 反复自触发。 */
		motion_int: motion_int {
			gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "LIS2DW12 INT1";
		};

		/* 锁位置反馈微动开关 */
		lock_sense: lock_sense {
			gpios = <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "lock feedback";
		};
	};

	ebike_outputs {
		compatible = "gpio-leds";

		/* 锁驱动。电磁锁 vs 电机锁还没定（DESIGN.md §7 第 1 条），
		 * 这里按「一根线，高有效，脉冲驱动」写，定了之后可能要改成半桥两根线。 */
		lock_drive: lock_drive {
			gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
			label = "lock actuator";
		};

		/* 电池采样分压的门控 MOSFET。分压器常通是 5.96 µA @58.8 V
		 * （4.7M+4.7M/470k，见下面 vbatt 节点），和 nRF52840 自己
		 * GPIOTE PORT 的 2.36 µA 同一量级，所以只在测的瞬间开
		 * （DESIGN.md §3.6）。
		 *
		 * ⚠ **曾经填 P0.04，那个脚这块板没引出**（文件头 §1）。P0.04 大概
		 * 是从两处抄来的：正品 nice!nano 的 `BATIN/P0.04`，以及克隆板那份
		 * 画错的原理图 —— `archive/ADR-001 §5.6` 早就记了「R10/R11 铜箔
		 * 实际走到 P0.24 不是 P0.04」。而 P0.24 在本 overlay 里是 i2c0 SDA，
		 * 所以那两个 0201 焊盘**永远不要贴件**：贴上就是往 I2C 数据线上
		 * 挂一个分压器。
		 * 现在用 **P0.10 = J3.2**，和 ADC 脚 P0.31 同在 J3，走线短。
		 * 不占 P0.02/P0.29 是因为只有 3 个真 ADC 脚，别拿去做数字输出。 */
		batt_gate: batt_gate {
			gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
			label = "battery divider gate";
		};

		/* GNSS 电源门控。开关管型号未定（DESIGN.md §7.2）。 */
		gnss_power: gnss_power {
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
			label = "GNSS power";
		};

		/* Air780EP PWRKEY：开集拉低 >1 s 开机。
		 * ⚠ 模组内部已有 5.6k 上拉，**不要外加上拉**（DESIGN.md §8.1）。
		 * 模组上电不自启动，所以这根线是必须的 —— 它接不上就是整条 4G
		 * 链路起不来。
		 *
		 * ⚠ **曾经填 P0.12，那个脚这块板没引出**（文件头 §1）。这条比
		 * P0.26 那条严重得多：P0.26 没有任何代码取用，而这根线
		 * `modem.c:26` 一直在用。
		 * 现在用 **P1.00 = J2.10**，和 modem 的 uart1（P0.17/P0.20 = J2.6/J2.7）
		 * 同在 J2；P1.00 是 normal-drive 脚，驱动开集三极管没问题。 */
		modem_pwrkey: modem_pwrkey {
			gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
			label = "Air780EP PWRKEY";
		};
	};

	/* 电池电压采样。ADC 只有 3 个真脚（DESIGN.md §3.5）：
	 * P0.02(AIN0) / P0.29(AIN5) / P0.31(AIN7)。用 P0.31。
	 * ZMK 的 A6~A10 别名不是 SAADC 通道，别当模拟脚用。
	 *
	 * 分压比 **21:1** —— 上臂 4.7M + 4.7M 串联，下臂 470k。三个约束定的：
	 *
	 * 1. **引脚不能烧**。本板 REGOUT0=3V3 → VDD = 3.3 V 是工作上限
	 *    （nRF52840 PS v1.1 Table 172）；Table 173 的绝对最大是
	 *    VDD+0.3 = 3.6 V，但那是「短时暴露不永久损坏」，不是可用范围。
	 *    58.8 V / 21 = 2800 mV，1% 电阻最坏偏差下 2856 mV，余 444 mV。
	 *    要顶到 3.3 V 得电池到 68 V。
	 *    ⚠ 上一版是 1M/1M（2:1），58.8 V 会往 P0.31 灌 29.4 V —— **焊上就烧**。
	 * 2. **源阻抗 ≤ 800 kΩ**，否则下面那个 40 µs 采集时间不成立
	 *    （PS v1.1 §6.23.10.1 的 tACQ 表：10k→3 µs … 800k→40 µs）。
	 *    Rs = 9.4M ‖ 470k = 448 kΩ ✓。这条否掉了 20M/1M（Rs 952 kΩ 超标）。
	 * 3. **单只电阻的耐压**。上臂拆两只，每只只担 28 V。单只 15M 要担 56 V，
	 *    而 0603 厚膜的 Max. RCWV 是 75 V、0402 只有 50 V —— 余量太薄。
	 *    拆成两只之后封装随便选。
	 *
	 * 21:1 恰好整除（9.87M / 470k = 21），但代码不依赖这一点：
	 * battery.c 走 voltage_divider_scale_dt()（int64），非整数比例同样准。
	 *
	 * ⚠ 换电池规格必须重算 —— BUILD_ASSERT 的输入 `PACK_MAX_MV` 在 battery.c。 */
	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc 7>;
		output-ohms = <470000>;
		full-ohms = <(4700000 + 4700000 + 470000)>;
		power-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* gain 1/6 + 内部参考 600 mV → ADC 满量程 3600 mV
	 * （nrfx `ANALOG_REF_INTERNAL_VAL = 600`，非 nRF54 分支）。
	 * 注意满量程 3600 mV 只是**转换器**的上限，引脚的上限是 VDD = 3300 mV，
	 * 两者不是一回事 —— 分压比按 3300 mV 算，见 vbatt 节点第 1 条。
	 *
	 * 40 µs 采集时间对应源阻抗 ≤ 800 kΩ（PS v1.1 §6.23.10.1）。
	 * 本分压的 Rs = 448 kΩ，也满足 20 µs（≤400 kΩ）—— 但采样是几分钟
	 * 一次的事，多花 20 µs 换余量，不优化。 */
	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};

/* --- I2C：LIS2DW12 ---------------------------------------------------------
 * 地址 0x19 要求 SA0/SDO 接 VDD_IO。
 * ⚠ SA0 接地的话内部 20.4~54.4 kΩ 上拉会白烧 110~160 µA（DESIGN.md §3.7）。
 *
 * ⚠ **不装外部上拉电阻**，用 nRF52840 的内部上拉（见下面 pinctrl 的
 * `bias-pull-up`）。因此 `clock-frequency` **必须留在 100 kHz** ——
 * 内部 RPU 最坏 16 kΩ，400 kHz 的 300 ns 上升时间要求总线电容 ≤ 22 pF，
 * 达不到。改快之前先装外部 2.2~4.7 kΩ。
 */
&i2c0 {
	status = "okay";
	compatible = "nordic,nrf-twim";
	clock-frequency = <I2C_BITRATE_STANDARD>;   /* 100 kHz，见上面第 2 条 */
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	lis2dw12: lis2dw12@19 {
		compatible = "st,lis2dw12";
		reg = <0x19>;
		irq-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;   /* 属性名是 irq-gpios */
		int-pin = <1>;
		odr = <12>;                  /* 12.5 Hz → 1 µA @LP mode 1 */
		range = <2>;                 /* ±2 g，阈值一格 31.25 mg */
		power-mode = <LIS2DW12_DT_LP_M1>;
		wakeup-duration = <LIS2DW12_DT_WAKEUP_2_ODR>;
	};
};

/* --- UART0：GNSS（ATGM336H-5N，NMEA 9600） --------------------------------- */
&uart0 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

/* --- UART1：Air780EP AT 链路 -----------------------------------------------
 * 9600 锁死：AT+IPR 默认自适应太脆，而两种低功耗模式都要求 9600
 * 才能可靠唤醒（DESIGN.md §8.1）。出厂 AT+IPR=9600;&W 设一次。
 */
&uart1 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	/* ⚠ uart0 不能用上游默认的 P0.09/P0.10：那是本工程留出来的余量脚
	 * （原本给 NFCT，见文件头 §1），而且 SPI1 的默认 MOSI 也在 P0.10。
	 * 挪到 P0.06/P0.08（DESIGN.md §3.4）。 */
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 6)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 8)>;
			bias-pull-up;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 6)>,
				<NRF_PSEL(UART_RX, 0, 8)>;
			low-power-enable;
		};
	};

	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 17)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 20)>;
			bias-pull-up;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 17)>,
				<NRF_PSEL(UART_RX, 0, 20)>;
			low-power-enable;
		};
	};

	/* ⚠ **`bias-pull-up` 这两行是 I2C 能不能通的前提，不是优化。**
	 *
	 * nrfx 的 `TWIM_PIN_INIT`（nrfx_twim.c:68）本来会给 SCL/SDA 配
	 * `NRF_GPIO_PIN_PULLUP`，但 Zephyr 的 twim 驱动传的是
	 * `skip_gpio_cfg = true` + `skip_psel_cfg = true`（i2c_nrfx_twim.c:306），
	 * 那段整个被跳过 —— **引脚配置完全由 pinctrl 决定**。
	 * 少了这两行，pincfg 的 pull 字段是 `NRF_PULL_NONE`（实测：`0x0C000018`
	 * / `0x0B000016`），两根线上内外都没有上拉，I2C 一个字节都传不出去。
	 * 加上之后是 `0x0C000618` / `0x0B000616`（pull=3=NRF_PULL_UP，
	 * 从 `__pinctrl_state_pins_0__device_dts_ord_*` 解出来核对过）。
	 *
	 * 用内部上拉（RPU 11/13/16 kΩ min/typ/max，PS v1.1 GPIO 电气规格）
	 * 换掉两只外部电阻，**代价是两条硬约束**：
	 *
	 * 1. **必须停在 100 kHz。** 上升时间 t_r = 0.847·R·C（30%→70%）：
	 *    16 kΩ 最坏 + 30 pF ≈ 407 ns，100 kHz 的 1000 ns 上限够；
	 *    400 kHz 只有 300 ns，要求 C ≤ 22 pF —— 做不到。
	 *    所以 `clock-frequency` 必须留在 `I2C_BITRATE_STANDARD`。
	 * 2. **总线电容 ≤ 74 pF**（16 kΩ 下正好 1000 ns）。短杜邦线挂一个
	 *    LIS2DW12 完全够（焊盘 3 pF + 传感器两脚约 20 pF + 线材几 pF）。
	 *    **再挂第二个 I2C 器件、或线拉到半米以上，余量就没了** —— 而 I2C
	 *    的临界失效很难看：偶发 NACK、偶发读到错值，不是干脆不通。
	 *    要扩展就装外部 2.2~4.7 kΩ 并把这两行删掉。
	 *
	 * 功耗上没有代价：上拉只在线被拉低时流 3.3 V / 13 kΩ = 254 µA，
	 * 而 I2C 空闲是高电平、几分钟才采样几百微秒，平均下来是皮安级。
	 */
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 24)>,
				<NRF_PSEL(TWIM_SCL, 0, 22)>;
			bias-pull-up;
		};
	};

	/* sleep 态也要保留上拉。这个状态带 `low-power-enable`，pinctrl 会强制
	 * `dir=INPUT` + `input=DISCONNECT`，但 `NRF_GET_PULL` 照旧生效
	 * （pinctrl_nrf.c:586 那一次 `nrf_gpio_cfg`）。保留上拉让总线在休眠期间
	 * 停在高电平而不是悬空 —— `PIN_CNF` 是 retained 寄存器，System OFF
	 * 下也保持。悬空输入正是 §3.7 那条「电压停在 VIL/VIH 之间会增加电流」
	 * 想避免的情况。 */
	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 24)>,
				<NRF_PSEL(TWIM_SCL, 0, 22)>;
			bias-pull-up;
			low-power-enable;
		};
	};
};

/* --- 关掉上游板级 DTS 打开、但本工程不用的外设 ----------------------------------
 * 每一个都在抢排针脚（文件头 §3）。`status = "disabled"` 之后驱动不实例化，
 * pinctrl 也就不会在 init 时被应用。
 *
 * ⚠ pwm0（P0.15）**故意不关**：P0.15 是板载蓝 LED，不引出、不占排针脚，
 * 而 `pwmleds`/`mcuboot-led0` 那几个节点引用着它，关掉只增加风险不换来余量。
 */

/* i2c1 = P1.04/P1.06 = J2.12/J2.13。这个是真丢脚：CONFIG_I2C_NRFX_TWIM=y
 * 会让 twim1 实例化并在 init 里应用 pinctrl（文件头 §3）。 */
&i2c1 {
	status = "disabled";
};

/* spi2 = P1.01/P1.02/P1.07 = 整个 J4。当前 CONFIG_SPI 没开所以还没丢，
 * 但谁哪天开了 SPI 就会连带吃掉 J4 三个脚 —— 提前关掉。
 * 板级 aliases 里的 `spi = &spi2` 留着无害：没有代码 DEVICE_DT_GET 它。 */
&spi2 {
	status = "disabled";
};

/* spi1 在 SoC dtsi 里本来就是 disabled，这里显式写一遍是因为 ZMK 的
 * `spi1_default` 把 MOSI 放在 P0.10 —— 而 P0.10 现在是 `batt_gate`。
 * 将来若真把 BOARD_ROOT 换成 ZMK 的 nice_nano，这一行是那条冲突的护栏。 */
&spi1 {
	status = "disabled";
};
